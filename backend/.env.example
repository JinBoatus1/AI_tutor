# 从 https://platform.openai.com/account/api-keys 获取并填写
OPENAI_API_KEY=sk-your-key-here

# -----------------------------------------------------------------------------
# LLM gateway
# Leave LLM_PROVIDER unset to preserve the current OpenAI behavior.
#
# Windows llama.cpp / LM Studio / Linux vLLM all use the same
# OpenAI-compatible client. Only these values change between environments.
# -----------------------------------------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BACKEND=llama_cpp
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=aitutor-main
# LLM_VISION_MODEL=aitutor-vision
# LLM_TOOL_MODEL=aitutor-main
# LLM_TIMEOUT_SECONDS=180
# LLM_VALIDATE_CAPABILITIES=true
# LLM_REGISTRY_PATH=C:/absolute/path/to/model_registry.json
# LLM_GPU_LAYERS is consumed by scripts/start_local_llm.ps1.
# LLM_GPU_LAYERS=999

# Run the backend without downloading a model. This only tests integration.
# LLM_PROVIDER=mock
# LLM_MODEL=aitutor-main
# LLM_MOCK_RESPONSE=Local LLM mock response.

# Maximum student answer files accepted by one AutoGrader batch/folder upload.
AUTOGRADER_MAX_BATCH_FILES=200

# Optional AutoGrader prompt and image-token tuning.
# AUTOGRADER_PROMPTS_PATH=C:/absolute/path/to/prompts.json
AUTOGRADER_LAYOUT_MAX_DIMENSION=1280
AUTOGRADER_LAYOUT_JPEG_QUALITY=78
AUTOGRADER_RECOGNIZER_IMAGE_DPI=120
AUTOGRADER_EVALUATOR_IMAGE_DPI=110
AUTOGRADER_VISION_JPEG_QUALITY=80
